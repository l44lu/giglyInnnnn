# Express trust proxy configuration for reverse proxies / load balancers.
# Safe default is false (direct connection / no proxy; ignores client-supplied X-Forwarded-For).
# ONLY modify this when the actual deployment proxy topology is known:
#   TRUST_PROXY=false      (default: direct connection, no trusted proxy)
#   TRUST_PROXY=true       (trusts all hops; use only if behind a trusted front-facing proxy)
#   TRUST_PROXY=1          (trusts 1 hop / single reverse proxy)
#   TRUST_PROXY=loopback   (trusts loopback addresses: 127.0.0.1/8, ::1/128)
#   TRUST_PROXY=10.0.0.0/8 (trusts specific subnet/CIDR)
TRUST_PROXY=false
